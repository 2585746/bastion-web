---
/**
 * Bloque decorativo tipo terminal con extractos saneados (sin IP ni nombres internos).
 * Es ilustrativo: se oculta a los lectores de pantalla y el texto equivalente está en la página.
 */
interface Props {
  title: string;
  lines: readonly { kind: 'cmd' | 'out' | 'ok' | 'note'; text: string }[];
}
const { title, lines } = Astro.props;
---

<figure class="term" aria-hidden="true">
  <div class="term__bar">
    <span class="term__dot"></span><span class="term__dot"></span><span class="term__dot"></span>
    <span class="term__title">{title}</span>
  </div>
  <pre class="term__body">{lines.map((l) => <span class={`l l--${l.kind}`}>{l.text}{'\n'}</span>)}<span class="cursor"></span></pre>
</figure>

<style>
  /* Interfaz real en un marco: superficie carbón, línea interior y radio de 12 px */
  .term {
    margin: 0;
    background: var(--surface-carbon);
    box-shadow: var(--shadow-subtle);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  .term__bar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--color-graphite);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-mono);
    color: var(--color-fog);
  }
  .term__dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: var(--radius-full);
    background: var(--color-graphite);
  }
  .term__title {
    margin-left: 0.75rem;
  }
  .term__body {
    margin: 0;
    padding: 1.25rem 1.25rem 1.5rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-mono);
    line-height: 1.71;
    color: var(--color-mist);
  }
  .l--cmd {
    color: var(--color-paper);
  }
  .l--cmd::before {
    content: '$ ';
    color: var(--color-fog);
  }
  /* Estado correcto: verde de apoyo, como etiqueta */
  .l--ok {
    color: var(--color-pulse-green);
  }
  .l--note {
    color: var(--color-fog);
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--color-mist);
    animation: blink 1.1s steps(2, start) infinite;
  }
  @keyframes blink {
    to {
      visibility: hidden;
    }
  }
</style>
