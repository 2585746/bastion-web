---
/**
 * Bloque decorativo tipo terminal con extractos saneados (sin IP ni nombres internos).
 * Es ilustrativo: se oculta a los lectores de pantalla y el texto equivalente está en la página.
 */
interface Props {
  title: string;
  lines: readonly { kind: 'cmd' | 'out' | 'ok' | 'note'; text: string }[];
}
const { title, lines } = Astro.props;
---

<figure class="term" aria-hidden="true">
  <div class="term__bar">
    <span class="term__dot"></span><span class="term__dot"></span><span class="term__dot"></span>
    <span class="term__title">{title}</span>
  </div>
  <pre class="term__body">{lines.map((l) => <span class={`l l--${l.kind}`}>{l.text}{'\n'}</span>)}<span class="cursor"></span></pre>
</figure>

<style>
  .term {
    margin: 0;
    background: #101010;
    border: 1px solid var(--border);
    border-top: 2px solid var(--red);
    border-radius: var(--radius);
    background-image: linear-gradient(180deg, var(--red-glow-soft), transparent 40%);
    overflow: hidden;
  }
  .term__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--border);
    font-size: var(--fs-ui);
    color: var(--text-muted);
  }
  .term__dot {
    width: 0.55rem;
    height: 0.55rem;
    background: var(--border);
  }
  .term__dot:first-child {
    background: var(--red);
  }
  .term__title {
    margin-left: 0.75rem;
  }
  .term__body {
    margin: 0;
    padding: 1.25rem 1.25rem 1.5rem;
    overflow-x: auto;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--text-muted);
  }
  .l--cmd {
    color: var(--text);
  }
  .l--cmd::before {
    content: '$ ';
    color: var(--red-text);
  }
  .l--ok {
    color: #7bd88f;
  }
  .l--note {
    color: #8a8a8a;
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--red-text);
    animation: blink 1.1s steps(2, start) infinite;
  }
  @keyframes blink {
    to {
      visibility: hidden;
    }
  }
</style>
