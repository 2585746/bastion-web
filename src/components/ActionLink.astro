---
interface Props {
  href: string;
  /** Abre en una pestaña nueva y muestra ↗ en lugar de →. */
  external?: boolean;
}
const { href, external = false } = Astro.props;
---

<a class="action" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}
  ><slot /> <span aria-hidden="true">{external ? '↗' : '→'}</span>{external && <span class="sr-only"> (se abre en una pestaña nueva)</span>}</a
>

<style>
  /* Enlace de texto: blanco niebla, peso 510; la flecha se desplaza al pasar el cursor */
  .action {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    color: var(--color-mist);
    font-size: var(--text-ui);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-body);
  }
  .action span {
    color: var(--color-fog);
    transition: transform var(--t), color var(--t);
  }
  .action:hover {
    color: var(--color-paper);
    text-decoration: underline;
    text-decoration-color: var(--color-smoke);
    text-underline-offset: 3px;
  }
  .action:hover span {
    color: var(--color-paper);
    transform: translateX(2px);
  }
</style>
