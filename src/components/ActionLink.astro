---
interface Props {
  href: string;
  /** Abre en una pestaña nueva y muestra ↗ en lugar de →. */
  external?: boolean;
}
const { href, external = false } = Astro.props;
---

<a class="action" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}
  ><slot /> <span aria-hidden="true">{external ? '↗' : '→'}</span>{external && <span class="sr-only"> (se abre en una pestaña nueva)</span>}</a
>

<style>
  .action {
    display: inline-flex;
    gap: 0.5rem;
    color: var(--red-text);
    font-size: var(--fs-ui);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .action span {
    transition: transform var(--t);
  }
  .action:hover {
    color: var(--text);
  }
  .action:hover span {
    transform: translateX(4px);
  }
</style>
