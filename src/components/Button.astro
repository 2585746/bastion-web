---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  icon?: IconName;
  download?: boolean;
  /** Abre en una pestaña nueva y añade el icono ↗. */
  external?: boolean;
  size?: 'md' | 'sm';
}

const { href, variant = 'primary', icon, download, external = false, size = 'md' } = Astro.props;
const shownIcon = external ? 'external' : icon;
---

<a
  class:list={['btn', `btn--${variant}`, `btn--${size}`]}
  href={href}
  download={download}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <slot />
  {shownIcon && <Icon name={shownIcon} size={16} />}
  {external && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.75rem;
    border-radius: var(--radius);
    font-size: var(--fs-ui);
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    line-height: 1;
    transition: background var(--t), color var(--t), border-color var(--t);
  }
  .btn--sm {
    padding: 0.7rem 1rem;
    letter-spacing: 1.8px;
    gap: 0.4rem;
  }
  .btn--primary {
    background: var(--red);
    color: var(--text);
    border: 1px solid var(--red);
  }
  .btn--primary:hover {
    background: var(--red-dark);
    border-color: var(--red-dark);
    color: var(--text);
  }
  .btn--ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }
  .btn--ghost:hover {
    border-color: var(--text-muted);
    color: var(--text);
  }
</style>
