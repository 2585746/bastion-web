---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href: string;
  /**
   * primary: relleno lima, una sola por vista.
   * ghost: contorno fino gris grafito.
   * neutral: pastilla blanca para la llamada de la barra de navegación.
   */
  variant?: 'primary' | 'ghost' | 'neutral';
  icon?: IconName;
  download?: boolean;
  /** Abre en una pestaña nueva y añade el icono ↗. */
  external?: boolean;
  size?: 'md' | 'sm';
}

const { href, variant = 'primary', icon, download, external = false, size = 'md' } = Astro.props;
const shownIcon = external ? 'external' : icon;
---

<a
  class:list={['btn', `btn--${variant}`, `btn--${size}`]}
  href={href}
  download={download}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <slot />
  {shownIcon && <Icon name={shownIcon} size={size === 'sm' ? 14 : 16} />}
  {external && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-md);
    font-size: var(--text-ui);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-body);
    line-height: 1.2;
    white-space: nowrap;
    transition: background var(--t), color var(--t), box-shadow var(--t);
  }
  .btn--sm {
    padding: 0.4375rem 0.75rem;
    font-size: var(--text-caption);
    gap: 0.375rem;
  }

  /* Acción principal: el único relleno de color de la vista */
  .btn--primary {
    background: var(--color-acid-lime);
    color: var(--color-void);
    box-shadow: var(--shadow-button);
  }
  .btn--primary:hover {
    background: #eef56a;
    color: var(--color-void);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-mist);
    box-shadow: inset 0 0 0 1px var(--color-graphite);
  }
  .btn--ghost:hover {
    background: var(--surface-tint);
    color: var(--color-paper);
    box-shadow: inset 0 0 0 1px var(--color-smoke);
  }

  /* Pastilla neutra: blanco sobre negro, sin color */
  .btn--neutral {
    background: var(--color-paper);
    color: var(--color-void);
    border-radius: var(--radius-full);
  }
  .btn--neutral:hover {
    background: var(--color-bone);
    color: var(--color-void);
  }

  .btn:focus-visible {
    outline-offset: 3px;
  }
</style>
