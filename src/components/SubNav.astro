---
/**
 * Menú de anclas con indicador de sección activa.
 * - Menos de 80 rem: barra de pastillas pegada bajo el menú principal.
 * - 80 rem o más: riel de números en el margen izquierdo; la etiqueta aparece al pasar el cursor o enfocar.
 * Sin JavaScript todos los enlaces funcionan; el script solo marca la sección visible.
 */
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

<nav class="subnav" aria-label="En esta página">
  <ul>
    {
      items.map((it, i) => (
        <li>
          <a href={`#${it.id}`}>
            <span class="subnav__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="subnav__label">{it.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .subnav {
    position: sticky;
    top: 4rem;
    z-index: 40;
    background: rgb(8 9 10 / 0.86);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-graphite);
  }
  .subnav ul {
    display: flex;
    gap: 0.375rem;
    list-style: none;
    margin: 0 auto;
    padding: 0.5rem var(--gutter);
    max-width: calc(var(--page-max-width) + 2 * var(--gutter));
    overflow-x: auto;
    scrollbar-width: none;
  }
  .subnav ul::-webkit-scrollbar {
    display: none;
  }
  /* Pastilla: fondo tenue, radio completo */
  .subnav a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--surface-tint);
    color: var(--color-mist);
    font-size: var(--text-caption);
    white-space: nowrap;
    transition: color var(--t), background var(--t), box-shadow var(--t);
  }
  .subnav__n {
    color: var(--color-fog);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-mono);
  }
  .subnav a:hover,
  .subnav a[aria-current='location'] {
    color: var(--color-paper);
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 1px var(--color-smoke);
  }
  .subnav a[aria-current='location'] .subnav__n {
    color: var(--color-paper);
  }

  @media (min-width: 80rem) {
    .subnav {
      position: fixed;
      top: 50%;
      left: 1rem;
      transform: translateY(-50%);
      z-index: 45;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border: 0;
    }
    .subnav ul {
      flex-direction: column;
      gap: 0.25rem;
      padding: 0;
      overflow: visible;
    }
    .subnav li {
      position: relative;
    }
    .subnav a {
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      padding: 0;
      border-radius: var(--radius-md);
      background: var(--surface-carbon);
      box-shadow: var(--shadow-subtle);
    }
    /* La etiqueta sale hacia la derecha como un rótulo */
    .subnav__label {
      position: absolute;
      left: calc(100% + 0.5rem);
      top: 50%;
      transform: translate(-0.25rem, -50%);
      padding: 0.375rem 0.625rem;
      border-radius: var(--radius-md);
      background: var(--surface-obsidian);
      box-shadow: var(--shadow-strong);
      color: var(--color-paper);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--t), transform var(--t);
    }
    .subnav a:hover .subnav__label,
    .subnav a:focus-visible .subnav__label {
      opacity: 1;
      transform: translate(0, -50%);
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.subnav ul');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.subnav a')];
  const byId = new Map(links.map((a) => [a.hash.slice(1), a]));
  const observer = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((l) => l.removeAttribute('aria-current'));
        const a = byId.get(e.target.id);
        a?.setAttribute('aria-current', 'location');
        if (a && bar && bar.scrollWidth > bar.clientWidth) {
          bar.scrollTo({ left: a.offsetLeft - bar.clientWidth / 2 + a.offsetWidth / 2 });
        }
      }
    },
    { rootMargin: '-35% 0px -60% 0px' },
  );
  byId.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>
