---
export interface TimelineItem {
  period: string;
  role: string;
  org: string;
  points: string[];
}
interface Props {
  items: TimelineItem[];
}
const { items } = Astro.props;
---

<ol class="tl">
  {
    items.map((i) => (
      <li class="tl__item reveal">
        <span class="tl__node" aria-hidden="true" />
        <p class="tl__period">{i.period}</p>
        <h3>{i.role}</h3>
        <p class="tl__org">{i.org}</p>
        <ul class="lines">
          {i.points.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>

<style>
  .tl {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 2rem;
  }
  .tl::before {
    content: '';
    position: absolute;
    left: 0.3125rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--color-graphite);
  }
  .tl__item {
    position: relative;
    padding-bottom: 2.5rem;
  }
  .tl__item:last-child {
    padding-bottom: 0;
  }
  .tl__node {
    position: absolute;
    left: -2rem;
    top: 0.3rem;
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: var(--radius-full);
    background: var(--color-void);
    box-shadow: inset 0 0 0 1px var(--color-fog);
  }
  .tl__item:first-child .tl__node {
    background: var(--color-bone);
    box-shadow: 0 0 0 3px var(--color-void);
  }
  /* El periodo es un metadato: monoespaciado pequeño */
  .tl__period {
    margin: 0 0 0.375rem;
    color: var(--color-fog);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-mono);
  }
  .tl__org {
    margin: 0 0 1rem;
    color: var(--color-fog);
    font-size: var(--text-body-sm);
  }
  h3 {
    margin-bottom: 0.15rem;
  }
</style>
