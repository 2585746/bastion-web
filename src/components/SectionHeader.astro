---
interface Props {
  eyebrow?: string;
  /** Las palabras entre asteriscos van en rojo: «Lo que *puedo demostrar*». */
  title: string;
  level?: 1 | 2;
  /** Numeración grande y decorativa en gris: "01", "02"… */
  num?: string;
}
const { eyebrow, title, level = 2, num } = Astro.props;
const H = level === 1 ? 'h1' : 'h2';
const parts = title.split(/\*([^*]+)\*/);
---

<header class="sh" data-num={num}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <H>{parts.map((p, i) => (i % 2 ? <em class="hl">{p}</em> : p))}</H>
  <div class="lead"><slot /></div>
</header>

<style>
  .sh {
    position: relative;
    margin-bottom: 3rem;
  }
  /* Numeración decorativa como contenido generado: no es texto del documento */
  .sh[data-num]::before {
    content: attr(data-num);
    position: absolute;
    top: -0.35em;
    right: 0;
    z-index: 0;
    color: var(--num);
    font-size: clamp(4rem, 11vw, 8rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    pointer-events: none;
    user-select: none;
  }
  .sh > * {
    position: relative;
    z-index: 1;
  }
</style>
