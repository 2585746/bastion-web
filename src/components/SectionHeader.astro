---
interface Props {
  eyebrow?: string;
  title: string;
  level?: 1 | 2;
  /** Numeración grande y decorativa en gris: "01", "02"… */
  num?: string;
}
const { eyebrow, title, level = 2, num } = Astro.props;
const H = level === 1 ? 'h1' : 'h2';
---

<header class="sh" data-num={num}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <H>{title}</H>
  <div class="lead"><slot /></div>
</header>

<style>
  .sh {
    position: relative;
    margin-bottom: 3rem;
  }
  /* Numeración decorativa como contenido generado: no es texto del documento */
  .sh[data-num]::before {
    content: attr(data-num);
    position: absolute;
    top: -0.35em;
    right: 0;
    z-index: 0;
    color: var(--num);
    font-size: clamp(5rem, 14vw, 10rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    pointer-events: none;
    user-select: none;
  }
  .sh > * {
    position: relative;
    z-index: 1;
  }
</style>
