---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
/** Las cifras puramente numéricas se animan con un contador CSS; el valor real queda en el texto. */
const numeric = /^\d+$/.test(value);
---

<div class="stat reveal">
  <span class="stat__value">
    {
      numeric ? (
        <>
          <span class="sr-only">{value}</span>
          <span class="count" aria-hidden="true" style={`--n:${value}`} />
        </>
      ) : (
        value
      )
    }
  </span>
  <span class="stat__label">{label}</span>
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-graphite);
  }
  /* Cifras grandes en blanco papel, peso 510 y tracking cerrado; sin degradado */
  .stat__value {
    color: var(--color-paper);
    font-size: clamp(3rem, 7vw, 4rem);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
  }
  .stat__label {
    color: var(--color-fog);
    font-size: var(--text-body-sm);
    line-height: 1.5;
    letter-spacing: var(--tracking-body);
    max-width: 18rem;
  }
</style>
