---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
/** Las cifras puramente numéricas se animan con un contador CSS; el valor real queda en el texto. */
const numeric = /^\d+$/.test(value);
---

<div class="stat reveal">
  <span class="stat__value">
    {
      numeric ? (
        <>
          <span class="sr-only">{value}</span>
          <span class="count" aria-hidden="true" style={`--n:${value}`} />
        </>
      ) : (
        value
      )
    }
  </span>
  <span class="stat__label">{label}</span>
</div>

<style>
  .stat {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }
  .stat::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.5rem;
    height: 2px;
    background: var(--red);
  }
  /* Cifras enormes con degradado de blanco a gris */
  .stat__value {
    color: var(--text);
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(180deg, #ffffff 25%, #8c8c8c);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .stat__label {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
</style>
