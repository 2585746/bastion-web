---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
/** Las cifras puramente numéricas se animan con un contador CSS; el valor real queda en el texto. */
const numeric = /^\d+$/.test(value);
---

<div class="stat reveal">
  <span class="stat__value">
    {
      numeric ? (
        <>
          <span class="sr-only">{value}</span>
          <span class="count" aria-hidden="true" style={`--n:${value}`} />
        </>
      ) : (
        value
      )
    }
  </span>
  <span class="stat__label">{label}</span>
</div>

<style>
  .stat {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }
  .stat::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.5rem;
    height: 2px;
    background: var(--red);
  }
  .stat__value {
    color: var(--red);
    font-size: clamp(2.75rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat__label {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
</style>
