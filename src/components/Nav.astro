---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Button from './Button.astro';
import LangSwitch from './LangSwitch.astro';
import { t, type Lang } from '../i18n/ui';
import { href } from '../lib/url';

interface Props {
  lang: Lang;
  altHref: string;
}

const { lang, altHref } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '');

/** Enlaces del portafolio. Bastión es un área propia y va aparte, como pastilla neutra. */
const items = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.blog', path: '/blog' },
  { key: 'nav.about', path: '/sobre-mi' },
] as const;
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href={href('/', lang)}>
      <Logo size={22} />
      <span class="nav__name">Martín De Prada</span>
    </a>

    <nav id="nav-menu" class="nav__menu" aria-label="Principal">
      <ul>
        {
          items.map(({ key, path }) => {
            const url = href(path, lang);
            const active = url.replace(/\/$/, '') === current;
            return (
              <li>
                <a href={url} aria-current={active ? 'page' : undefined}>
                  {t(lang, key)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="nav__actions">
      <Button href={href('/bastion', lang)} external size="sm" variant="neutral">{t(lang, 'nav.bastion')}</Button>
      <LangSwitch lang={lang} altHref={altHref} />
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
        <Icon name="menu" size={20} />
        <span class="sr-only">{t(lang, 'nav.menu')}</span>
      </button>
    </div>
  </div>
</header>

<style>
  /* Barra fija arriba: logo a la izquierda, enlaces y acciones a la derecha */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(8 9 10 / 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-graphite);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-paper);
    font-weight: var(--fw-medium);
    font-size: var(--text-body);
    letter-spacing: var(--tracking-body);
  }
  .nav__brand:hover {
    color: var(--color-paper);
  }
  .nav__menu {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }
  .nav__menu ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__menu a {
    display: block;
    padding: 0.5rem 0.75rem;
    color: var(--color-mist);
    font-size: var(--text-caption);
    border-radius: var(--radius-md);
  }
  .nav__menu a:hover {
    color: var(--color-paper);
    text-decoration: underline;
    text-decoration-color: var(--color-smoke);
    text-underline-offset: 4px;
  }
  .nav__menu a[aria-current='page'] {
    color: var(--color-paper);
    background: var(--surface-tint);
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav__toggle {
    display: none;
    background: none;
    border: 0;
    box-shadow: inset 0 0 0 1px var(--color-graphite);
    color: var(--color-mist);
    padding: 0.4375rem;
    border-radius: var(--radius-md);
    cursor: pointer;
  }
  .nav__toggle:hover {
    color: var(--color-paper);
    background: var(--surface-tint);
  }

  @media (max-width: 860px) {
    .nav__menu {
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--color-void);
      border-bottom: 1px solid var(--color-graphite);
      display: none;
    }
    .nav__menu.is-open {
      display: block;
    }
    .nav__menu ul {
      flex-direction: column;
      gap: 0.125rem;
      padding: 0.5rem var(--gutter) 1rem;
    }
    .nav__menu li a {
      padding: 0.75rem;
      font-size: var(--text-body-sm);
    }
    .nav__actions {
      margin-left: auto;
    }
    .nav__toggle {
      display: inline-flex;
    }
  }
  /* En pantallas muy estrechas solo se ve la marca; el nombre queda para lectores de pantalla */
  @media (max-width: 40rem) {
    .nav__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
    .nav__inner {
      gap: 0.5rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('nav-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('is-open', !open);
  });
</script>
