---
/**
 * Marca de Bastión: una torre con almenas y una «B» de línea fina.
 * Mismo trazo que los iconos del sitio. Decorativa: el nombre va en el texto contiguo.
 */
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true" class="logo">
  <path d="M4 29V5h5.5v4.5H13V5h6v4.5h3.5V5H28v24z" fill="var(--red)"></path>
  <path
    d="M13 12v12M13 12h4.2a3.1 3.1 0 010 6.2H13M13 18.2h4.8a3.1 3.1 0 010 5.8H13"
    stroke="#141414"
    stroke-width="2.1"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
