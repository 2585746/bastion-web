---
/**
 * Encabezado propio del área Bastión (un «mini sitio»): marca, vuelta al portafolio, idioma
 * y subpestañas fijas al hacer scroll con la pestaña activa marcada con el indicador lima.
 */
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { href } from '../lib/url';
import type { Lang } from '../i18n/ui';

export type BastionTab = 'funcionamiento' | 'conexiones' | 'estado' | 'incidencias' | 'hoja-de-ruta';

interface Props {
  lang: Lang;
  altHref: string;
  current: BastionTab;
}
const { lang, altHref, current } = Astro.props;

const tabs: { id: BastionTab; label: string; path: string }[] = [
  { id: 'funcionamiento', label: 'Funcionamiento', path: '/bastion' },
  { id: 'conexiones', label: 'Conexiones', path: '/bastion/conexiones' },
  { id: 'estado', label: 'Estado', path: '/bastion/estado' },
  { id: 'incidencias', label: 'Incidencias', path: '/bastion/incidencias' },
  { id: 'hoja-de-ruta', label: 'Hoja de ruta', path: '/bastion/hoja-de-ruta' },
];
---

<header class="bhead">
  <div class="container bhead__inner">
    <a class="bhead__brand" href={href('/bastion', lang)}>
      <Logo size={22} />
      <span>Bastión</span>
    </a>
    <a class="bhead__back" href={href('/', lang)}><span aria-hidden="true">←</span> Portafolio</a>
    <div class="bhead__lang"><LangSwitch lang={lang} altHref={altHref} /></div>
  </div>
</header>
<nav class="btabs" aria-label="Bastión">
  <ul class="container">
    {
      tabs.map((t) => (
        <li>
          <a href={href(t.path, lang)} aria-current={t.id === current ? 'page' : undefined}>
            {t.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .bhead {
    position: sticky;
    top: 0;
    z-index: 51;
    background: rgb(8 9 10 / 0.86);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .bhead__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 3.5rem;
  }
  .bhead__brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-paper);
    font-size: var(--text-body);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-body);
  }
  .bhead__brand:hover {
    color: var(--color-paper);
  }
  .bhead__back {
    color: var(--color-fog);
    font-size: var(--text-caption);
    padding-left: 1rem;
    border-left: 1px solid var(--color-graphite);
  }
  .bhead__back:hover {
    color: var(--color-paper);
  }
  .bhead__lang {
    margin-left: auto;
  }

  .btabs {
    position: sticky;
    top: 3.5rem;
    z-index: 50;
    background: rgb(8 9 10 / 0.86);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-graphite);
  }
  .btabs ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin-block: 0;
    padding-block: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .btabs ul::-webkit-scrollbar {
    display: none;
  }
  .btabs a {
    position: relative;
    display: block;
    padding: 0.875rem 0.75rem;
    color: var(--color-fog);
    font-size: var(--text-caption);
    white-space: nowrap;
  }
  .btabs a:hover {
    color: var(--color-paper);
  }
  .btabs a[aria-current='page'] {
    color: var(--color-paper);
    font-weight: var(--fw-medium);
  }
  /* Indicador de pestaña activa: la única línea lima del área */
  .btabs a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: -1px;
    height: 2px;
    border-radius: var(--radius-sm);
    background: var(--color-acid-lime);
  }
  .btabs a:focus-visible {
    outline-offset: -2px;
  }

  /* Pantallas estrechas y zoom alto: solo las pestañas quedan fijas, para no comerse la zona de lectura */
  @media (max-width: 40rem) {
    .bhead {
      position: relative;
    }
    .btabs {
      top: 0;
    }
    .bhead__inner {
      gap: 0.75rem;
    }
    .bhead__back {
      padding-left: 0.75rem;
    }
    /* Pista de que las pestañas siguen a la derecha: el borde se desvanece */
    .btabs ul {
      mask-image: linear-gradient(90deg, #000 calc(100% - 3rem), transparent);
    }
    /* Al llegar al final del desplazamiento, la pista desaparece */
    @supports (animation-timeline: scroll(self inline)) {
      .btabs ul {
        animation: tabs-end linear both;
        animation-timeline: scroll(self inline);
      }
      @keyframes tabs-end {
        90% {
          mask-image: linear-gradient(90deg, #000 calc(100% - 3rem), transparent);
        }
        to {
          mask-image: linear-gradient(90deg, #000 100%, transparent);
        }
      }
    }
  }
</style>
