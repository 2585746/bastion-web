---
/**
 * Desplegable de idioma accesible, con <details>: funciona con teclado y sin JavaScript.
 * Un script mínimo lo cierra con Escape o al hacer clic fuera.
 */
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Ruta equivalente en el otro idioma. */
  altHref: string;
}
const { lang, altHref } = Astro.props;
const current = Astro.url.pathname;
const options = [
  { code: 'es', label: 'Español', href: lang === 'es' ? current : altHref },
  { code: 'en', label: 'English', href: lang === 'en' ? current : altHref },
] as const;
---

<details class="lang">
  <summary aria-label={lang === 'es' ? 'Idioma: Español' : 'Language: English'}>
    <span aria-hidden="true">{lang.toUpperCase()}</span>
    <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
  </summary>
  <ul>
    {
      options.map((o) => (
        <li>
          <a href={o.href} lang={o.code} hreflang={o.code} aria-current={o.code === lang ? 'true' : undefined}>
            {o.label}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang {
    position: relative;
  }
  /* Botón fantasma: contorno grafito, radio 6 px */
  .lang summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4375rem 0.625rem;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-graphite);
    color: var(--color-mist);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-mono);
    cursor: pointer;
    list-style: none;
    transition: box-shadow var(--t), background var(--t), color var(--t);
  }
  .lang summary::-webkit-details-marker {
    display: none;
  }
  .lang summary:hover,
  .lang[open] summary {
    color: var(--color-paper);
    background: var(--surface-tint);
    box-shadow: inset 0 0 0 1px var(--color-smoke);
  }
  .lang svg {
    transition: transform var(--t);
  }
  .lang[open] svg {
    transform: rotate(180deg);
  }
  .lang ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.375rem);
    z-index: 80;
    min-width: 9rem;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: var(--surface-obsidian);
    box-shadow: var(--shadow-strong), 0 4px 32px rgb(8 9 10 / 0.6);
    border-radius: var(--radius-md);
  }
  .lang a {
    display: block;
    padding: 0.5rem 0.625rem;
    border-radius: var(--radius-badge);
    color: var(--color-mist);
    font-size: var(--text-caption);
  }
  .lang a:hover,
  .lang a[aria-current='true'] {
    color: var(--color-paper);
    background: var(--surface-tint);
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('details.lang').forEach((d) => {
    const close = () => d.removeAttribute('open');
    document.addEventListener('click', (e) => {
      if (d.open && !d.contains(e.target as Node)) close();
    });
    d.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && d.open) {
        close();
        d.querySelector('summary')?.focus();
      }
    });
  });
</script>
