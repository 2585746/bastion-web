---
/**
 * Diagrama de arquitectura por capas, en HTML y CSS para que se adapte a cualquier ancho.
 * Muestra capas y flujos; no contiene direcciones ni nombres internos.
 */
const inside = [
  { kind: 'Contenedor', name: 'Uptime Kuma', note: 'Monitorización' },
  { kind: 'Contenedor', name: 'Pi-hole', note: 'DNS y filtrado' },
  { kind: 'Anfitrión', name: 'Glances', note: 'Sensores y recursos' },
];
const docker = ['Nginx Proxy Manager', 'Homepage', 'n8n + agente de IA'];
const outside = [
  { name: 'ntfy', note: 'Alertas al móvil' },
  { name: 'Healthchecks.io', note: 'Vigilante externo' },
  { name: 'Gemini API', note: 'Resúmenes del agente' },
  { name: 'Google Drive', note: 'Copia cifrada (rclone)' },
];
const flows = [
  'n8n lee Proxmox, Uptime Kuma y Glances con tokens de solo lectura y pide los resúmenes a la API de Gemini.',
  'Uptime Kuma y Proxmox envían sus alertas a ntfy.',
  'El hipervisor manda un latido cada 5 minutos a Healthchecks.io; si deja de llegar, ese servicio avisa por ntfy.',
  'Las copias diarias se cifran con rclone antes de salir a Google Drive.',
];
---

<figure class="arch">
  <div class="arch__tier">
    <span class="arch__tag">Cliente</span>
    <div class="node node--wide"><strong>Móvil o PC</strong><span>con cliente Tailscale</span></div>
  </div>

  <div class="arch__link"><span>Túnel WireGuard · ningún puerto abierto en el router</span></div>

  <div class="arch__tier arch__box">
    <span class="arch__tag arch__tag--main">Hipervisor · Proxmox VE · router de subred</span>
    <div class="arch__grid">
      {
        inside.map((n) => (
          <div class="node">
            <small>{n.kind}</small>
            <strong>{n.name}</strong>
            <span>{n.note}</span>
          </div>
        ))
      }
      <div class="node node--docker">
        <small>Máquina virtual</small>
        <strong>Plataforma Docker</strong>
        <ul>
          {docker.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <div class="arch__link"><span>Alertas, latidos, consultas a la API y copias salen hacia</span></div>

  <div class="arch__tier">
    <span class="arch__tag">Servicios externos</span>
    <div class="arch__grid arch__grid--out">
      {
        outside.map((n) => (
          <div class="node">
            <strong>{n.name}</strong>
            <span>{n.note}</span>
          </div>
        ))
      }
    </div>
  </div>

  <figcaption>
    <h3>Flujos principales</h3>
    <ul>
      {flows.map((f) => <li>{f}</li>)}
    </ul>
  </figcaption>
</figure>

<style>
  .arch {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .arch__tier {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  /* Rótulo de capa: metadato técnico en monoespaciado */
  .arch__tag {
    color: var(--color-fog);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-mono);
  }
  .arch__tag--main {
    color: var(--color-mist);
  }
  /* El anfitrión es el marco principal: tarjeta carbón con línea interior */
  .arch__box {
    background: var(--surface-carbon);
    box-shadow: var(--shadow-subtle);
    border-radius: var(--radius-xl);
    padding: var(--card-padding);
  }
  .arch__grid {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 36rem) {
    .arch__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .node {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.75rem 1rem;
    background: var(--surface-obsidian);
    box-shadow: var(--shadow-subtle);
    border-radius: var(--radius-md);
    line-height: 1.5;
  }
  .arch__tier:not(.arch__box) .node {
    background: var(--surface-carbon);
  }
  .node--wide {
    max-width: 22rem;
  }
  .node strong {
    color: var(--color-paper);
    font-weight: var(--fw-medium);
    font-size: var(--text-body-sm);
  }
  .node span {
    color: var(--color-fog);
    font-size: var(--text-caption);
  }
  .node small {
    color: var(--color-fog);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-mono);
  }
  .node--docker {
    grid-column: 1 / -1;
  }
  .node ul {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .node li {
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-badge);
    background: var(--surface-tint);
    font-size: var(--text-label);
    color: var(--color-mist);
  }

  /* Conector vertical con etiqueta */
  .arch__link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.25rem 0 0.25rem 1.5rem;
    min-height: 3.5rem;
    border-left: 1px solid var(--color-smoke);
    margin: 0 0 0.75rem 1.5rem;
    position: relative;
  }
  .arch__link::after {
    content: '';
    position: absolute;
    left: -5px;
    bottom: -1px;
    width: 9px;
    height: 9px;
    border-right: 1px solid var(--color-smoke);
    border-bottom: 1px solid var(--color-smoke);
    transform: rotate(45deg) translate(-3px, -3px);
  }
  .arch__link span {
    color: var(--color-fog);
    font-size: var(--text-caption);
  }

  figcaption {
    margin-top: 3rem;
  }
  figcaption h3 {
    font-size: var(--text-body-lg);
    font-weight: var(--fw-strong);
  }
  figcaption ul {
    margin: 0;
    padding-left: 1.25rem;
  }
  figcaption li {
    margin-bottom: 0.375rem;
    font-size: var(--text-body-sm);
    line-height: 1.6;
  }
  figcaption li::marker {
    color: var(--color-fog);
  }
</style>
