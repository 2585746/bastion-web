---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from './ActionLink.astro';
import { href } from '../lib/url';
import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
  path: string;
  title: string;
}

const { lang = 'es', path, title } = Astro.props;
const es = lang === 'es';
---

<BaseLayout
  lang={lang}
  title={title}
  description={es ? `${title}: todavía sin contenido publicado.` : `${title}: English version not written yet.`}
  altHref={href(path, es ? 'en' : 'es')}
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">{es ? 'Todavía vacío' : 'Not in English yet'}</span>
      <h1>{title}</h1>
      <p class="lead">
        {
          es
            ? 'Aquí todavía no hay nada publicado. Mientras tanto, lo que he montado y cómo lo resolví está en Bastión.'
            : "This page isn't in English yet. I'm writing the English version from scratch rather than machine-translating it. The Spanish page has the full detail."
        }
      </p>
      {
        es ? (
          <ActionLink href={href('/bastion')}>Ver Bastión</ActionLink>
        ) : (
          <ActionLink href={href(path)}>Read the Spanish page</ActionLink>
        )
      }
    </div>
  </section>
</BaseLayout>
