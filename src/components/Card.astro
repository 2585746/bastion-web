---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  title: string;
  icon?: IconName;
  href?: string;
  featured?: boolean;
  /** Texto de la llamada a la acción al pie de una tarjeta enlazada. */
  cta?: string;
  /** Nivel del título (h3 por defecto). */
  level?: 3 | 4;
  /** El enlace se abre en una pestaña nueva (↗). */
  external?: boolean;
}

const { title, icon, href, featured = false, cta, level = 3, external = false } = Astro.props;
const Title = level === 4 ? 'h4' : 'h3';
const Tag = href ? 'a' : 'article';
---

<Tag
  class:list={['card', 'reveal', { 'card--featured': featured }]}
  href={href}
  target={href && external ? '_blank' : undefined}
  rel={href && external ? 'noopener' : undefined}
>
  {
    icon && (
      <span class="card__iconbox">
        <Icon name={icon} size={20} class="card__icon" />
      </span>
    )
  }
  <Title class="card__title">{title}</Title>
  <div class="card__body"><slot /></div>
  {
    cta && (
      <span class="card__cta">
        {cta} <span aria-hidden="true">{external ? '↗' : '→'}</span>
        {external && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
      </span>
    )
  }
</Tag>

<style>
  /* Marco de vitrina: superficie carbón, línea interior de 1 px y radio de 12 px. Sin sombra exterior. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: var(--card-padding);
    border-radius: var(--radius-xl);
    background: var(--surface-carbon);
    box-shadow: var(--shadow-subtle);
    color: var(--color-mist);
    transition: background var(--t), box-shadow var(--t);
  }
  a.card:hover,
  a.card:focus-visible {
    background: var(--surface-obsidian);
    box-shadow: var(--shadow-strong);
    color: var(--color-mist);
  }
  a.card:focus-visible {
    outline: 2px solid var(--color-mist);
    outline-offset: 2px;
    border-radius: var(--radius-xl);
  }

  /* Icono de línea gris en un recuadro con borde fino */
  .card__iconbox {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 1rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-subtle);
    background: var(--surface-tint);
  }
  .card :global(.card__icon) {
    color: var(--color-mist);
  }
  .card__title {
    margin-bottom: 0.5rem;
    font-size: var(--text-body-lg);
    font-weight: var(--fw-strong);
    line-height: 1.4;
    letter-spacing: var(--tracking-body);
  }
  .card__body {
    flex: 1;
    font-size: var(--text-body-sm);
    line-height: 1.6;
    letter-spacing: var(--tracking-body);
  }
  .card__body :global(p:last-child),
  .card__body :global(.lines:last-child) {
    margin-bottom: 0;
  }
  .card__cta {
    margin-top: 1.25rem;
    color: var(--color-mist);
    font-size: var(--text-caption);
    font-weight: var(--fw-medium);
  }
  .card__cta span {
    display: inline-block;
    color: var(--color-fog);
    transition: transform var(--t), color var(--t);
  }
  a.card:hover .card__cta {
    color: var(--color-paper);
  }
  a.card:hover .card__cta span {
    color: var(--color-paper);
    transform: translateX(2px);
  }

  /* Destacada: superficie elevada y línea de más contraste; sin color */
  .card--featured {
    background: var(--surface-obsidian);
    box-shadow: var(--shadow-strong);
  }
  .card--featured .card__iconbox {
    background: var(--color-bone);
    box-shadow: none;
  }
  .card--featured :global(.card__icon) {
    color: var(--color-void);
  }
</style>
