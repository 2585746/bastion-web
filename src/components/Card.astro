---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  title: string;
  icon?: IconName;
  href?: string;
  featured?: boolean;
  /** Texto de la llamada a la acción al pie de una tarjeta enlazada. */
  cta?: string;
  /** Nivel del título (h3 por defecto). */
  level?: 3 | 4;
}

const { title, icon, href, featured = false, cta, level = 3 } = Astro.props;
const Title = level === 4 ? 'h4' : 'h3';
const Tag = href ? 'a' : 'article';
---

<Tag class:list={['card', 'reveal', { 'card--featured': featured }]} href={href}>
  {
    icon && (
      <span class="card__iconbox">
        <Icon name={icon} size={40} class="card__icon" />
      </span>
    )
  }
  <Title class="card__title">{title}</Title>
  <div class="card__body"><slot /></div>
  {cta && <span class="card__cta">{cta} <span aria-hidden="true">→</span></span>}
</Tag>

<style>
  /* Cristal oscuro: borde con degradado fino, brillo que sigue al cursor y elevación sutil */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 2rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, rgb(31 31 31 / 0.96), rgb(24 24 24 / 0.96)) padding-box,
      linear-gradient(150deg, rgb(255 255 255 / 0.16), rgb(224 43 47 / 0.32) 38%, rgb(255 255 255 / 0.05) 75%) border-box;
    color: var(--text-muted);
    overflow: hidden;
    transition: transform var(--t), background var(--t);
  }
  /* Brillo que sigue al cursor: --mx y --my los fija un script de pocas líneas */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(18rem circle at var(--mx, 50%) var(--my, 0%), rgb(224 43 47 / 0.16), transparent 65%);
    opacity: 0;
    transition: opacity var(--t);
    pointer-events: none;
  }
  /* Borde superior rojo que crece al pasar el cursor o al enfocar */
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s ease;
    z-index: 1;
  }
  a.card:hover,
  a.card:focus-visible {
    transform: translateY(-4px);
    color: var(--text-muted);
  }
  a.card:hover::before,
  a.card:focus-visible::before {
    transform: scaleX(1);
  }
  a.card:hover::after,
  a.card:focus-visible::after {
    opacity: 1;
  }
  .card > * {
    position: relative;
    z-index: 2;
  }

  /* Icono de 40 px en un recuadro con degradado rojo muy tenue */
  .card__iconbox {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: 1.25rem;
    border: 1px solid rgb(224 43 47 / 0.35);
    border-radius: var(--radius);
    background: linear-gradient(145deg, rgb(224 43 47 / 0.18), rgb(224 43 47 / 0.03));
  }
  .card :global(.card__icon) {
    color: var(--red-text);
  }
  .card__title {
    margin-bottom: 0.5rem;
  }
  .card__body {
    flex: 1;
  }
  .card__body :global(p:last-child),
  .card__body :global(.lines:last-child) {
    margin-bottom: 0;
  }
  .card__cta {
    margin-top: 1.25rem;
    color: var(--red-text);
    font-size: var(--fs-ui);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .card__cta span {
    display: inline-block;
    transition: transform var(--t);
  }
  a.card:hover .card__cta span {
    transform: translateX(4px);
  }

  .card--featured {
    background:
      var(--red-gradient) padding-box,
      linear-gradient(150deg, rgb(255 255 255 / 0.4), rgb(255 255 255 / 0.05)) border-box;
    color: var(--text);
  }
  .card--featured::before {
    background: var(--text);
  }
  .card--featured::after {
    background: radial-gradient(18rem circle at var(--mx, 50%) var(--my, 0%), rgb(255 255 255 / 0.18), transparent 65%);
  }
  .card--featured .card__iconbox {
    border-color: rgb(255 255 255 / 0.4);
    background: rgb(0 0 0 / 0.2);
  }
  .card--featured :global(.card__icon),
  .card--featured .card__body,
  .card--featured .card__cta {
    color: var(--text);
  }
  .card--featured :global(.chip) {
    background: rgb(0 0 0 / 0.22);
    border-color: rgb(255 255 255 / 0.3);
    color: var(--text);
  }
  .card--featured :global(.lines li::before) {
    background: var(--text);
  }
  a.card--featured:hover,
  a.card--featured:focus-visible {
    color: var(--text);
  }
</style>
