---
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n/ui';
import { PROFILE } from '../lib/url';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__note">© {year} {PROFILE.name} · {t(lang, 'footer.static')}</p>
    <ul class="footer__links">
      <li>
        <a href={PROFILE.github} rel="me noopener"><Icon name="github" size={18} label="GitHub" /></a>
      </li>
      <li>
        <a href={PROFILE.linkedin} rel="me noopener"><Icon name="linkedin" size={18} label="LinkedIn" /></a>
      </li>
      {/* TODO (fase 4): mostrar el icono de RSS cuando exista el canal /rss.xml */}
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-graphite);
    padding-block: 2.5rem;
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }
  .footer__note {
    margin: 0;
    color: var(--color-fog);
    font-size: var(--text-caption);
  }
  .footer__links {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer__links a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    color: var(--color-fog);
    transition: color var(--t), background var(--t);
  }
  .footer__links a:hover {
    color: var(--color-paper);
    background: var(--surface-tint);
  }
</style>
