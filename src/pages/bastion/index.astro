---
import BastionLayout from '../../layouts/BastionLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ActionLink from '../../components/ActionLink.astro';
import Card from '../../components/Card.astro';
import { href } from '../../lib/url';
import { layers, decisions } from '../../data/bastion';
---

<BastionLayout
  tab="funcionamiento"
  title="Funcionamiento"
  description="Cómo funciona Bastión, el laboratorio de infraestructura y seguridad que administro en casa: Proxmox sin puertos abiertos, monitorización, copias probadas y un agente de IA de solo lectura."
  altHref={href('/bastion', 'en')}
  progress
>
  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Funcionamiento" title="*Bastión*, de punta a punta" level={1}>
        <p>
          Bastión es el servidor que administro en casa para practicar con infraestructura real y no solo con
          ejercicios. Empezó en octubre de 2026 como un Ubuntu Server dentro de mi PC y hoy es una plataforma
          Proxmox con DNS propio, monitorización, copias probadas, servicios en Docker y un agente de IA.
        </p>
        <p>
          Lo construí para administrar sistemas Linux y Windows sin las limitaciones de permisos de mi puesto, para
          practicar lo que estudio en ASIR y para tener servicios con uso real. Todo está documentado, incluidos 27 fallos reales con su causa y su solución.
        </p>
      </SectionHeader>
      <ActionLink href={href('/bastion/incidencias')}>Ver las incidencias</ActionLink>
    </div>
  </section>


  <section class="section" id="capas">
    <div class="container">
      <SectionHeader eyebrow="Capas" title="Qué hay en *cada capa*">
        <p>Qué monté, cómo lo comprobé y qué falló por el camino.</p>
      </SectionHeader>
      <div class="grid stagger">
        {
          layers.map((l) => (
            <div id={l.id} class="layer">
              <Card title={l.title} icon={l.icon} featured={l.featured}>
                <p>{l.text}</p>
              </Card>
            </div>
          ))
        }
      </div>
    </div>
  </section>


  <section class="section section--alt" id="decisiones">
    <div class="container">
      <SectionHeader eyebrow="Decisiones de diseño" title="Qué decidí y *por qué*">
        <p>Cada decisión tiene una razón, y varias salieron de un fallo concreto.</p>
      </SectionHeader>
      <dl class="decisions">
        {
          decisions.map((d) => (
            <div class="decision">
              <dt>{d.what}</dt>
              <dd>{d.why}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

</BastionLayout>

<style>
  .layer {
    display: flex;
    scroll-margin-top: 9rem;
  }
  @media (min-width: 52rem) {
    .layer:last-child {
      grid-column: 1 / -1;
    }
  }
  .layer :global(.card) {
    flex: 1;
  }

  /* Decisiones */
  .decisions {
    margin: 0;
  }
  .decision {
    display: grid;
    gap: 0.5rem 3rem;
    grid-template-columns: 1fr;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }
  .decision:last-child {
    border-bottom: 1px solid var(--border);
  }
  .decision dt {
    color: var(--text);
    font-weight: 600;
    line-height: 1.5;
  }
  .decision dd {
    margin: 0;
  }
  @media (min-width: 52rem) {
    .decision {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    }
  }

</style>
