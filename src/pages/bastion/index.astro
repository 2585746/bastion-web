---
import BastionLayout from '../../layouts/BastionLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ActionLink from '../../components/ActionLink.astro';
import Card from '../../components/Card.astro';
import { href } from '../../lib/url';
import { layers, decisions, facts } from '../../data/bastion';
import incidencias from '../../data/bastion/incidencias.json';

/* Las cifras salen de los datos, no se escriben a mano: así no se desfasan de la página de incidencias. */
const publicadas = incidencias.length;
const [y, m, d] = facts.asOf.split('-');
const fecha = `${d}/${m}/${y}`;
---

<BastionLayout
  tab="funcionamiento"
  title="Funcionamiento"
  description="Cómo funciona Bastión, el laboratorio de infraestructura y seguridad que administro en casa: Proxmox sin puertos abiertos, monitorización, copias probadas y un agente de IA de solo lectura."
  altHref={href('/bastion', 'en')}
  progress
>
  <section class="section" aria-labelledby="t-bastion">
    <div class="container intro">
      <SectionHeader eyebrow="Funcionamiento" title="*Bastión*, de punta a punta" level={1} id="t-bastion">
        <p>
          Soy técnico de soporte IT y estudiante de ASIR. Bastión es el servidor que administro en casa para practicar
          con infraestructura real, sin las limitaciones de permisos de mi puesto. Empezó en octubre de 2026 como un
          Ubuntu Server dentro de mi PC y hoy es una plataforma Proxmox con DNS propio, monitorización, copias
          probadas, servicios en Docker y un agente de IA.
        </p>
      </SectionHeader>

      <section class="guardia" aria-labelledby="t-guardia">
        <h2 class="guardia__head" id="t-guardia">
          Entrada de guardia <time datetime={facts.asOf}>{fecha}</time>
        </h2>
        <dl class="guardia__log">
          <div><dt>Puertos abiertos en el router</dt><dd>0</dd></div>
          <div><dt>Incidencias publicadas</dt><dd>{publicadas}</dd></div>
          <div><dt>Monitores activos</dt><dd>{facts.monitores}</dd></div>
          <div><dt>Copias</dt><dd>restauración probada</dd></div>
          <div><dt>Agente de IA</dt><dd>solo lectura</dd></div>
        </dl>
        <ActionLink href={href('/bastion/incidencias')}>Ver las incidencias</ActionLink>
      </section>
    </div>
  </section>

  <section class="section" id="capas" aria-labelledby="t-capas">
    <div class="container">
      <SectionHeader eyebrow="Capas" title="Qué hay en *cada capa*" id="t-capas">
        <p>Qué hace cada parte, en una línea. El detalle técnico está plegado en cada tarjeta.</p>
      </SectionHeader>
      <ul class="grid stagger layers" role="list">
        {
          layers.map((l) => (
            <li id={l.id} class:list={['layer', { 'layer--featured': l.featured }]}>
              <Card title={l.title} icon={l.icon} featured={l.featured}>
                <p class="layer__summary">{l.summary}</p>
                <details class="layer__more">
                  <summary>Detalle técnico</summary>
                  <p>{l.text}</p>
                </details>
              </Card>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" id="decisiones" aria-labelledby="t-decisiones">
    <div class="container">
      <SectionHeader eyebrow="Decisiones de diseño" title="Qué decidí y *por qué*" id="t-decisiones">
        <p>Cada decisión tiene una razón, y varias salieron de un fallo concreto.</p>
      </SectionHeader>
      <dl class="decisions">
        {
          decisions.map((d) => (
            <div class="decision">
              <dt>{d.what}</dt>
              <dd>{d.why}</dd>
            </div>
          ))
        }
      </dl>

      <div class="cierre">
        <p>Los fallos que llevaron a estas decisiones están publicados, y el estado de cada servicio se puede consultar.</p>
        <ul class="cierre__links" role="list">
          <li><ActionLink href={href('/bastion/incidencias')}>Ver las incidencias</ActionLink></li>
          <li><ActionLink href={href('/bastion/estado')}>Ver el estado actual</ActionLink></li>
        </ul>
      </div>
    </div>
  </section>
</BastionLayout>

<style>
  /* Cabecera: presentación a la izquierda, entrada de guardia a la derecha */
  .intro {
    display: grid;
    gap: 2.5rem;
  }
  .intro :global(.sh) {
    margin-bottom: 0;
  }
  @media (min-width: 60rem) {
    .intro {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: end;
      gap: 4rem;
    }
  }

  /* Entrada de guardia: un registro con fecha, cifras en monoespaciado porque son datos */
  .guardia {
    padding: var(--card-padding);
    background: var(--surface-carbon);
    box-shadow: var(--shadow-subtle);
    border-radius: var(--radius-xl);
  }
  .guardia__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0 0 0.5rem;
    color: var(--color-paper);
    font-size: var(--text-ui);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-body);
    line-height: 1.5;
  }
  .guardia__head time {
    color: var(--color-fog);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-regular);
    letter-spacing: var(--tracking-mono);
  }
  .guardia__log {
    margin: 0 0 1.25rem;
  }
  .guardia__log div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-graphite);
  }
  .guardia__log dt {
    color: var(--color-fog);
    font-size: var(--text-caption);
    line-height: 1.5;
  }
  .guardia__log dd {
    margin: 0;
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-mono);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  /* Capas */
  .layers {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .layer {
    display: flex;
    scroll-margin-top: 8rem;
  }
  @media (max-width: 40rem) {
    .layer {
      scroll-margin-top: 4.5rem;
    }
  }
  @media (min-width: 44rem) {
    .layer--featured {
      grid-column: 1 / -1;
    }
  }
  .layer :global(.card) {
    flex: 1;
  }

  /* Resumen visible y detalle técnico plegado */
  .layer__summary {
    color: var(--color-paper);
    line-height: 1.6;
  }
  .layer__more {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-graphite);
  }
  .layer__more summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    color: var(--color-mist);
    font-size: var(--text-caption);
    font-weight: var(--fw-medium);
  }
  .layer__more summary::-webkit-details-marker {
    display: none;
  }
  .layer__more summary:hover {
    color: var(--color-paper);
  }
  /* Signo más dibujado con dos líneas; al abrir desaparece la vertical */
  .layer__more summary::after {
    content: '';
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    background:
      linear-gradient(currentColor, currentColor) center / 100% 1px no-repeat,
      linear-gradient(currentColor, currentColor) center / 1px 100% no-repeat;
    transition: background-size var(--t);
  }
  .layer__more[open] summary::after {
    background-size: 100% 1px, 0 100%;
  }
  .layer__more p {
    margin: 0.75rem 0 0;
    color: var(--color-mist);
    font-size: var(--text-body-sm);
    overflow-wrap: break-word;
  }
  .layer :global(.card--featured) .layer__more {
    border-top-color: var(--color-smoke);
  }

  /* Decisiones */
  .decisions {
    margin: 0;
  }
  .decision {
    display: grid;
    gap: 0.5rem 3rem;
    grid-template-columns: 1fr;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-graphite);
  }
  .decision:last-child {
    border-bottom: 1px solid var(--color-graphite);
  }
  .decision dt {
    color: var(--color-paper);
    font-weight: var(--fw-medium);
    line-height: 1.5;
  }
  .decision dd {
    margin: 0;
    color: var(--color-mist);
    font-size: var(--text-body-sm);
    line-height: 1.6;
  }
  @media (min-width: 52rem) {
    .decision {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    }
  }

  /* Cierre: el siguiente paso después de leer las decisiones */
  .cierre {
    margin-top: 3rem;
  }
  .cierre p {
    max-width: 40rem;
    color: var(--color-paper);
  }
  .cierre__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
