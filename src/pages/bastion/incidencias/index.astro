---
import BastionLayout from '../../../layouts/BastionLayout.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import Card from '../../../components/Card.astro';
import { href } from '../../../lib/url';
---

<BastionLayout
  tab="incidencias"
  title="Incidencias del sistema"
  description="Registro real de fallos y aprendizajes del proyecto Bastión."
  altHref={href('/bastion/incidencias', 'en')}
>
  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Incidencias" title="Fallos reales, documentados" level={1} />
      <p>
        Cada incidencia sigue el mismo formato: síntoma, diagnóstico, causa, solución y aprendizaje.
      </p>

      <!-- AQUÍ SE INSERTARÁN AUTOMÁTICAMENTE LAS INCIDENCIAS -->
      <div class="incidencias-grid" style="margin-top: 2rem;">
        <Card level={3}>
          <h3>Incidencia 26 — Bloqueo OAuth 403</h3>
          <p><strong>Área:</strong> Google Cloud / rclone</p>
          <p><strong>Síntoma:</strong> Bloqueo access_denied al autorizar rclone con el Client ID propio.</p>
          <p><strong>Causa:</strong> Proyecto OAuth en modo de prueba sin usuarios autorizados ni URLs de marca.</p>
          <p><strong>Solución:</strong> Rellenar URLs de marca, dominio autorizado y pasar la app a producción.</p>
        </Card>
      </div>

    </div>
  </section>
</BastionLayout>
