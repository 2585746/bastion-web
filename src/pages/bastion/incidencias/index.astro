---
import BastionLayout from '../../../layouts/BastionLayout.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import Card from '../../../components/Card.astro';
import { href } from '../../../lib/url';
import data from '../../../data/bastion/incidencias.json';

/**
 * Diseño fijo de la página de Incidencias.
 * Los datos viven en src/data/bastion/incidencias.json, que es lo único que modifica la automatización (n8n).
 * Este archivo se edita solo a mano.
 */

const CATEGORIAS = ['Proxmox', 'Linux', 'Redes', 'Docker', 'Ciberseguridad'] as const;
type Categoria = (typeof CATEGORIAS)[number];

interface Incidencia {
  id: number;
  title: string;
  category: Categoria;
  date: string;
  originalDate: string;
  area: string;
  symptom: string;
  diagnosis: string;
  cause: string;
  solution: string;
  learning: string;
}

const incidencias = (data as Incidencia[]).slice().sort((a, b) => b.id - a.id);
const presentes = CATEGORIAS.filter((c) => incidencias.some((i) => i.category === c));
const slug = (c: string) => c.toLowerCase();

/** Las cuatro reglas de diagnóstico del proyecto. */
const rules = [
  { icon: 'doc', title: '1 · Leer la salida literal', text: 'Un «correcto» o un «successful» no prueba nada.' },
  { icon: 'network', title: '2 · Recorrer la red en orden', text: 'IP, puerta de enlace, internet por IP y, al final, DNS.' },
  { icon: 'shield', title: '3 · Verificar lo efectivo', text: 'Se comprueba la configuración que se aplica, no la que se escribió.' },
  { icon: 'bug', title: '4 · Revisar los registros', text: 'Responden lo que la prueba funcional no.' },
] as const;

const apartados = [
  ['symptom', 'Síntoma'],
  ['diagnosis', 'Diagnóstico'],
  ['cause', 'Causa'],
  ['solution', 'Solución'],
  ['learning', 'Aprendizaje'],
] as const;
---

<BastionLayout
  tab="incidencias"
  title="Incidencias"
  description="Las incidencias documentadas de Bastión, cada una con síntoma, diagnóstico, causa, solución y aprendizaje."
  altHref={href('/bastion', 'en')}
>
  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Incidencias" title="Fallos reales, *documentados*" level={1}>
        <p>
          Cada incidencia sigue el mismo formato: síntoma, diagnóstico, causa, solución y aprendizaje. Se publican a
          medida que se revisan.
        </p>
      </SectionHeader>

      <h2 class="rules-title">Las cuatro reglas de diagnóstico</h2>
      <div class="grid stagger">
        {
          rules.map((r) => (
            <Card level={4} title={r.title} icon={r.icon}>
              <p>{r.text}</p>
            </Card>
          ))
        }
      </div>

      <div class="inc">
        <h2 class="rules-title">Listado <span class="inc__count">({incidencias.length} publicadas)</span></h2>

        {
          incidencias.length === 0 ? (
            <p class="inc__empty">Todavía no hay incidencias publicadas.</p>
          ) : (
            <div class="inc__filters" role="radiogroup" aria-label="Filtrar por categoría">
              <input type="radio" name="cat" id="cat-todas" value="todas" checked />
              <label for="cat-todas">Todas</label>
              {presentes.map((c) => (
                <>
                  <input type="radio" name="cat" id={`cat-${slug(c)}`} value={slug(c)} />
                  <label for={`cat-${slug(c)}`}>{c}</label>
                </>
              ))}

              <ol class="inc__list">
                {incidencias.map((inc) => (
                  <li class="inc__item" data-cat={slug(inc.category)}>
                    <Card level={3} title={`${inc.id} · ${inc.title}`}>
                      <ul class="chips inc__chips">
                        <li class="chip chip--cat">{inc.category}</li>
                        <li class="chip">{inc.area}</li>
                        <li class="chip">{inc.originalDate}</li>
                      </ul>
                      <dl class="inc__body">
                        {apartados.map(([k, label]) => (
                          <>
                            <dt>{label}</dt>
                            <dd>{inc[k]}</dd>
                          </>
                        ))}
                      </dl>
                    </Card>
                  </li>
                ))}
              </ol>
            </div>
          )
        }
      </div>
    </div>
  </section>
</BastionLayout>

<style>
  .rules-title {
    margin-bottom: 1.25rem;
    font-size: 1.25rem;
  }
  .inc {
    margin-top: 3rem;
  }
  .inc__count {
    color: var(--text-muted);
    font-weight: 400;
    font-size: var(--fs-body);
  }
  .inc__empty {
    color: var(--text-muted);
  }

  /* Filtros sin JavaScript: radios + :has() */
  .inc__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .inc__filters input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .inc__filters label {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--fs-ui);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color var(--t),
      border-color var(--t),
      background var(--t);
  }
  .inc__filters label:hover {
    color: var(--text);
    border-color: var(--red);
  }
  .inc__filters input:checked + label {
    background: var(--red);
    border-color: var(--red);
    color: var(--text);
  }
  .inc__filters input:focus-visible + label {
    outline: 2px solid var(--red-text);
    outline-offset: 2px;
  }

  .inc__list {
    flex-basis: 100%;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .inc__filters:has(input[value='proxmox']:checked) .inc__item:not([data-cat='proxmox']),
  .inc__filters:has(input[value='linux']:checked) .inc__item:not([data-cat='linux']),
  .inc__filters:has(input[value='redes']:checked) .inc__item:not([data-cat='redes']),
  .inc__filters:has(input[value='docker']:checked) .inc__item:not([data-cat='docker']),
  .inc__filters:has(input[value='ciberseguridad']:checked) .inc__item:not([data-cat='ciberseguridad']) {
    display: none;
  }

  .inc__chips {
    margin-bottom: 1rem;
  }
  .chip--cat {
    border-color: var(--red);
    color: var(--red-text);
    font-weight: 600;
  }
  .inc__body {
    margin: 0;
  }
  .inc__body dt {
    color: var(--red-text);
    font-size: var(--fs-ui);
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-top: 0.9rem;
  }
  .inc__body dd {
    margin: 0.25rem 0 0;
    line-height: 1.8;
    color: var(--text-muted);
  }
</style>
