---
import BastionLayout from '../../../layouts/BastionLayout.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import Card from '../../../components/Card.astro';
import { href } from '../../../lib/url';

/** Esqueleto: grupos que mostrará el panel. No hay datos publicados todavía. */
const groups = [
  { icon: 'server', title: 'Infraestructura', text: 'Hipervisor, DNS y filtrado, monitorización y vigilancia externa.' },
  { icon: 'container', title: 'Servicios', text: 'Plataforma Docker, proxy inverso, panel de inicio y automatización e IA.' },
  { icon: 'pulse', title: 'Hardware', text: 'Temperatura de la CPU y uso de memoria y de disco.' },
  { icon: 'backup', title: 'Copias', text: 'Resultado de la última copia local y de la copia cifrada fuera de casa.' },
] as const;
---

<BastionLayout
  tab="estado"
  title="Estado"
  description="Futuro panel público de solo lectura con el estado de Bastión. Todavía sin datos publicados."
  altHref={href('/bastion', 'en')}
>
  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Estado" title="Estado de Bastión: *aún sin datos públicos*" level={1}>
        <p>
          La monitorización ya funciona dentro de la red privada, con Uptime Kuma y el aviso externo de Healthchecks.io,
          pero todavía no publico sus datos. Cuando lo haga, esta página mostrará estos cuatro grupos, en solo lectura y
          sin enlaces a servicios internos.
        </p>
      </SectionHeader>
      <div class="grid stagger">
        {
          groups.map((g) => (
            <Card level={4} title={g.title} icon={g.icon}>
              <p>{g.text}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>
</BastionLayout>
