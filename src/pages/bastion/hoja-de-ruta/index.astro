---
import BastionLayout from '../../../layouts/BastionLayout.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import { href } from '../../../lib/url';
import { phases, statusLabel, progress, UPDATED } from '../../../data/roadmap';
---

<BastionLayout
  tab="hoja-de-ruta"
  title="Hoja de ruta"
  description="Hoja de ruta de Bastión por fases: qué está hecho, qué está en curso, qué falta (SOC, Active Directory, Ansible, nube) y qué se descartó."
  altHref={href('/bastion', 'en')}
>
  <section class="section" id="hoja-de-ruta">
    <div class="container">
      <SectionHeader eyebrow="Hoja de ruta" title="Qué está hecho y *qué falta*" level={1}>
        <p>
          Actualizada el {UPDATED}. Las fases con trabajo hecho o en curso aparecen abiertas. El SOC, Active Directory en
          Proxmox, Ansible y los laboratorios en Azure y AWS todavía no están hechos.
        </p>
      </SectionHeader>
      <ol class="phases">
        {
          phases.map((p) => {
            const { done, total } = progress(p);
            return (
              <li>
                <details open={p.status !== 'todo'}>
                  <summary>
                    <span class="phase__id">{p.id === 'base' ? 'Base' : `Fase ${p.id}`}</span>
                    <span class="phase__title">{p.title}</span>
                    <span class={`phase__status phase__status--${p.status}`}>{statusLabel[p.status]}</span>
                    <span class="phase__count">
                      {done} de {total}
                    </span>
                  </summary>
                  <p class="phase__summary">{p.summary}</p>
                  <ul class="items">
                    {p.items.map((i) => (
                      <li class={`item item--${i.status}`}>
                        <span class="item__mark" aria-hidden="true" />
                        <span class="sr-only">{statusLabel[i.status]}: </span>
                        <span class="item__text">{i.text}</span>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>
</BastionLayout>

<style>
  /* Hoja de ruta */
  .phases {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .phases > li {
    border-top: 1px solid var(--color-graphite);
  }
  .phases > li:last-child {
    border-bottom: 1px solid var(--color-graphite);
  }
  summary {
    display: grid;
    align-items: center;
    gap: 0.25rem 1.5rem;
    grid-template-columns: 5rem 1fr auto auto;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover .phase__title {
    color: var(--color-mist);
  }
  .phase__id {
    color: var(--color-fog);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-mono);
  }
  .phase__title {
    color: var(--color-paper);
    font-weight: var(--fw-medium);
    transition: color var(--t);
  }
  /* Estado de la fase como badge: verde si está hecha; el resto, neutro */
  .phase__status {
    justify-self: start;
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-badge);
    background: var(--surface-tint);
    color: var(--color-fog);
    font-size: var(--text-label);
    line-height: 1.4;
    white-space: nowrap;
  }
  .phase__status--done {
    color: var(--color-pulse-green);
    box-shadow: inset 0 0 0 1px rgb(39 166 68 / 0.4);
  }
  .phase__status--doing {
    color: var(--color-paper);
    box-shadow: inset 0 0 0 1px var(--color-smoke);
  }
  .phase__count {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-mono);
    color: var(--color-fog);
    min-width: 4rem;
    text-align: right;
  }
  .phase__summary {
    margin: 0 0 1rem 6.5rem;
    color: var(--color-mist);
    font-size: var(--text-body-sm);
  }
  .items {
    list-style: none;
    margin: 0 0 1.5rem 6.5rem;
    padding: 0;
  }
  .item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.25rem 0;
    color: var(--color-fog);
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }
  .item__mark {
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--color-fog);
    transform: translateY(0.05rem);
  }
  .item--done {
    color: var(--color-mist);
  }
  .item--done .item__mark {
    background: var(--color-pulse-green);
    box-shadow: none;
  }
  .item--doing {
    color: var(--color-paper);
  }
  .item--doing .item__mark {
    background: linear-gradient(90deg, var(--color-pulse-green) 50%, transparent 50%);
    box-shadow: inset 0 0 0 1px var(--color-pulse-green);
  }
  /* Descartado por decisión: atenuado y tachado, con una marca en aspa */
  .item--dropped {
    color: var(--color-fog);
  }
  .item--dropped .item__mark {
    box-shadow: inset 0 0 0 1px var(--color-ash);
    background: linear-gradient(135deg, transparent 45%, var(--color-ash) 45% 55%, transparent 55%);
  }
  .item--dropped .item__text {
    text-decoration: line-through;
    text-decoration-color: var(--color-ash);
  }

  @media (max-width: 40rem) {
    summary {
      grid-template-columns: 1fr auto;
    }
    .phase__id,
    .phase__title {
      grid-column: 1 / -1;
    }
    .phase__summary,
    .items {
      margin-left: 0;
    }
  }
</style>
