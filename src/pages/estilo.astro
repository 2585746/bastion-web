---
/* Guía de estilo: todos los componentes en un solo lugar. No se indexa. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import ActionLink from '../components/ActionLink.astro';
import Card from '../components/Card.astro';
import Stat from '../components/Stat.astro';
import Terminal from '../components/Terminal.astro';
import Timeline from '../components/Timeline.astro';
import Logo from '../components/Logo.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import { href } from '../lib/url';

const colors = [
  ['--bg', '#141414', 'Fondo principal'],
  ['--bg-alt', '#1A1A1A', 'Bloques alternos'],
  ['--surface', '#1F1F1F', 'Tarjetas'],
  ['--border', '#2A2A2A', 'Bordes'],
  ['--red', '#E02B2F', 'Acento: fondos y cifras'],
  ['--red-text', '#FF4A4E', 'Acento: texto pequeño (AA)'],
  ['--text', '#FFFFFF', 'Texto principal'],
  ['--text-muted', '#B5B5B5', 'Texto secundario'],
  ['--icon-neutral', '#6B6B6B', 'Íconos neutros'],
] as const;

const icons: IconName[] = [
  'server', 'shield', 'network', 'pulse', 'backup', 'container', 'bot', 'dns',
  'bug', 'doc', 'lock', 'arrow', 'download', 'github', 'linkedin', 'rss', 'mail',
  'terminal', 'database', 'cloud', 'scanner', 'user', 'ticket', 'eye',
];
---

<BaseLayout title="Guía de estilo" description="Componentes del sistema de diseño." altHref={href('/estilo', 'en')} noindex>
  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Sistema de diseño" title="Guía de estilo" level={1}>
        <p>Todos los componentes del sitio. Si una pantalla tiene mucho rojo, está mal.</p>
      </SectionHeader>

      <h2 class="g-title">Colores</h2>
      <div class="swatches">
        {
          colors.map(([v, hex, use]) => (
            <div class="swatch">
              <span class="swatch__chip" style={`background: var(${v})`} />
              <code>{v}</code>
              <span class="swatch__hex">{hex}</span>
              <span class="swatch__use">{use}</span>
            </div>
          ))
        }
      </div>
      <p class="note">
        Nota de accesibilidad: el rojo <code>#E02B2F</code> sobre el fondo oscuro tiene un contraste de 4,0:1, por
        debajo del mínimo AA (4,5:1) para texto pequeño. Se usa tal cual en botones, fondos y cifras grandes, y en
        su variante <code>#FF4A4E</code> (5,6:1) para etiquetas y enlaces.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 class="g-title">Tipografía</h2>
      <span class="eyebrow">Etiqueta destacada</span>
      <p class="g-h1">Título de página · 800</p>
      <h2>Título de sección · 800</h2>
      <h3>Título de tarjeta · 700</h3>
      <p class="lead">
        Párrafo de 15 px, peso 400 e interlineado 1.8 en gris secundario. Frases cortas y concretas, cada
        afirmación apoyada en algo verificable. Código en línea: <code>sshd -T</code>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="g-title">Botones y enlaces</h2>
      <div class="row">
        <Button href="#">Botón principal</Button>
        <Button href="#" icon="arrow">Con ícono</Button>
        <Button href="#" variant="ghost" icon="download">Secundario</Button>
      </div>
      <div class="row">
        <ActionLink href="#">Enlace de acción</ActionLink>
        <a href="#">Enlace en texto</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 class="g-title">Tarjetas</h2>
      <div class="grid">
        <Card title="Monitorización" icon="pulse">
          <p>Tarjeta estándar: ícono de línea en rojo, título blanco y texto gris.</p>
        </Card>
        <Card title="Agente de IA" icon="bot" featured>
          <p>Tarjeta destacada: gradiente rojo. Como máximo una por sección.</p>
        </Card>
        <Card title="Con enlace" icon="shield" href="#">
          <p>Tarjeta enlazada: al pasar el cursor se eleva y aparece un borde superior rojo.</p>
        </Card>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="g-title">Cifras</h2>
      <div class="stats">
        <Stat value="25" label="incidencias documentadas" />
        <Stat value="0" label="puertos abiertos" />
        <Stat value="3-2-1" label="copias (cifra no numérica: sin contador)" />
      </div>

      <h2 class="g-title">Íconos</h2>
      <ul class="icons">
        {
          icons.map((n) => (
            <li>
              <Icon name={n} size={28} />
              <span>{n}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <SectionHeader num="01" eyebrow="Componentes nuevos" title="Separador con numeración">
        <p>El número grande en gris es decorativo (contenido generado por CSS) y no compite con el título.</p>
      </SectionHeader>

      <h2 class="g-title">Chips y líneas técnicas</h2>
      <ul class="lines">
        <li>Línea técnica con marcador cuadrado rojo.</li>
        <li>Máximo tres por tarjeta, con tecnologías concretas.</li>
      </ul>
      <ul class="chips">
        <li class="chip">Proxmox VE</li>
        <li class="chip">Tailscale</li>
        <li class="chip">Pi-hole</li>
        <li class="chip">n8n</li>
      </ul>

      <h2 class="g-title">Tarjeta con evidencia</h2>
      <div class="grid">
        <Card level={4} title="Con llamada a la acción" icon="server" href="#" cta="Ver evidencia">
          <ul class="lines"><li>Enlaza a la parte donde se puede comprobar.</li></ul>
          <ul class="chips"><li class="chip">Chip</li></ul>
        </Card>
        <Card level={4} title="Destacada" icon="bot" href="#" featured cta="Ver evidencia">
          <ul class="lines"><li>Como máximo una por bloque.</li></ul>
          <ul class="chips"><li class="chip">Chip</li></ul>
        </Card>
      </div>

      <h2 class="g-title">Terminal decorativa</h2>
      <Terminal
        title="ejemplo · extractos saneados"
        lines={[
          { kind: 'note', text: '# Sin IP ni nombres internos' },
          { kind: 'cmd', text: 'sudo sshd -T | grep passwordauthentication' },
          { kind: 'out', text: 'passwordauthentication no' },
          { kind: 'ok', text: 'ok' },
        ]}
      />

      <h2 class="g-title">Línea de tiempo</h2>
      <Timeline
        items={[
          { period: 'Periodo', role: 'Puesto', org: 'Organización', points: ['Un punto breve con un dato concreto.'] },
          { period: 'Periodo anterior', role: 'Puesto', org: 'Organización', points: ['Otro punto.'] },
        ]}
      />

      <h2 class="g-title">Marca</h2>
      <div class="row">
        <Logo size={64} />
        <Logo size={32} />
        <Logo size={20} />
      </div>
      <p class="note">Torre con almenas y una «B» de línea fina. Se usa en el menú, el favicon y la imagen para redes (<code>public/og.png</code>, 1200×630).</p>

      <h2 class="g-title">Titulares</h2>
      <p class="note">Las palabras entre asteriscos en el título de <code>SectionHeader</code> salen en rojo: <em class="hl">así</em>. Las cifras grandes usan un degradado de blanco a gris.</p>

      <h2 class="g-title">Atmósfera</h2>
      <p class="note">Cada sección lleva una malla de degradados rojos de muy baja opacidad que cambia de posición (tres variantes), un grano sutil hecho con un SVG inline y, entre secciones, una línea de luz roja que se desvanece por los extremos.</p>

      <h2 class="g-title">Navegación de página</h2>
      <p class="note">
        <code>SubNav</code> es el menú de anclas de Bastión y Sobre mí: barra de chips bajo el menú en pantallas estrechas y riel de puntos
        numerados en el margen izquierdo desde 80 rem. Marca la sección visible con un script de pocas líneas. La barra de progreso de
        lectura (<code>progress</code> en <code>BaseLayout</code>) es solo CSS.
      </p>

      <h2 class="g-title">Efectos</h2>
      <p class="note">
        Resplandores y degradados rojos de baja opacidad (<code>--red-glow</code>, <code>--red-glow-soft</code>); nunca
        sombras pesadas. Las tarjetas son de cristal oscuro: borde con degradado y brillo que sigue al cursor (solo con ratón y sin movimiento reducido).
        El escalonado de entrada se activa con la clase <code>stagger</code> en la cuadrícula. El revelado al hacer scroll (<code>.reveal</code>) y los contadores (<code>.count</code>) usan solo
        CSS y desaparecen con <code>prefers-reduced-motion</code> o si el navegador no los admite.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .g-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 3rem 0 1.5rem;
  }
  .g-title:first-of-type {
    margin-top: 0;
  }
  .g-h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .swatches {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
  }
  .swatch {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: var(--fs-small);
  }
  .swatch__chip {
    height: 4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 0.5rem;
  }
  .swatch__hex {
    color: var(--text);
  }
  .note {
    margin-top: 2rem;
    font-size: var(--fs-small);
    max-width: 44rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .stats {
    display: grid;
    gap: 0 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }
  .icons {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .icons li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.25rem 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--red-text);
  }
  .icons span {
    color: var(--text-muted);
    font-size: var(--fs-ui);
  }
</style>
