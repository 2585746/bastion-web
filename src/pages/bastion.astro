---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ActionLink from '../components/ActionLink.astro';
import Card from '../components/Card.astro';
import ArchDiagram from '../components/ArchDiagram.astro';
import SubNav from '../components/SubNav.astro';
import { href } from '../lib/url';
import { layers, decisions } from '../data/bastion';
import { phases, statusLabel, progress, UPDATED } from '../data/roadmap';
---

<BaseLayout
  title="Bastión"
  description="Bastión es el laboratorio de infraestructura y seguridad que administro en casa: Proxmox sin puertos abiertos, monitorización, copias probadas y un agente de IA de solo lectura."
  altHref={href('/bastion', 'en')}
  progress
>
  <SubNav
    items={[
      { id: 'arquitectura', label: 'Arquitectura' },
      { id: 'capas', label: 'Capas' },
      { id: 'decisiones', label: 'Decisiones' },
      { id: 'hoja-de-ruta', label: 'Hoja de ruta' },
    ]}
  />
  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Proyecto" title="Bastión" level={1}>
        <p>
          Bastión es el servidor que administro en casa para practicar con infraestructura real y no solo con
          ejercicios. Empezó en octubre de 2026 como un Ubuntu Server dentro de mi PC y hoy es una plataforma
          Proxmox con DNS propio, monitorización, copias probadas, servicios en Docker y un agente de IA.
        </p>
        <p>
          Lo construí para administrar sistemas Linux y Windows sin las limitaciones de permisos de mi puesto, para
          practicar lo que estudio en ASIR y para tener servicios con uso real. Todo está documentado, incluidos 25
          fallos reales con su causa y su solución.
        </p>
      </SectionHeader>
      <ActionLink href={href('/incidencias')}>Ver las incidencias</ActionLink>
    </div>
  </section>

  <section class="section section--alt" id="arquitectura">
    <div class="container">
      <SectionHeader eyebrow="Arquitectura" title="Cómo *encaja* todo">
        <p>
          Un solo anfitrión con contenedores y máquinas virtuales, al que se llega únicamente por una red privada. Lo
          que sale al exterior son alertas, latidos y consultas a APIs, y el router no tiene ningún puerto abierto.
        </p>
      </SectionHeader>
      <ArchDiagram />
    </div>
  </section>

  <section class="section" id="capas">
    <div class="container">
      <SectionHeader eyebrow="Capas" title="Qué hay en *cada capa*">
        <p>Qué monté, cómo lo comprobé y qué falló por el camino.</p>
      </SectionHeader>
      <div class="grid stagger">
        {
          layers.map((l) => (
            <div id={l.id} class="layer">
              <Card title={l.title} icon={l.icon} featured={l.featured}>
                <p>{l.text}</p>
              </Card>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt" id="decisiones">
    <div class="container">
      <SectionHeader eyebrow="Decisiones de diseño" title="Qué decidí y *por qué*">
        <p>Cada decisión tiene una razón, y varias salieron de un fallo concreto.</p>
      </SectionHeader>
      <dl class="decisions">
        {
          decisions.map((d) => (
            <div class="decision">
              <dt>{d.what}</dt>
              <dd>{d.why}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" id="hoja-de-ruta">
    <div class="container">
      <SectionHeader eyebrow="Hoja de ruta" title="Estado *por fases*">
        <p>Actualizada el {UPDATED}. Las fases con trabajo hecho o en curso aparecen abiertas.</p>
      </SectionHeader>
      <ol class="phases">
        {
          phases.map((p) => {
            const { done, total } = progress(p);
            return (
              <li>
                <details open={p.status !== 'todo'}>
                  <summary>
                    <span class="phase__id">{p.id === 'base' ? 'Base' : `Fase ${p.id}`}</span>
                    <span class="phase__title">{p.title}</span>
                    <span class={`phase__status phase__status--${p.status}`}>{statusLabel[p.status]}</span>
                    <span class="phase__count">
                      {done} de {total}
                    </span>
                  </summary>
                  <p class="phase__summary">{p.summary}</p>
                  <ul class="items">
                    {p.items.map((i) => (
                      <li class={`item item--${i.status}`}>
                        <span class="item__mark" aria-hidden="true" />
                        <span class="sr-only">{statusLabel[i.status]}: </span>
                        {i.text}
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .layer {
    display: flex;
    scroll-margin-top: 6rem;
  }
  @media (min-width: 52rem) {
    .layer:last-child {
      grid-column: 1 / -1;
    }
  }
  .layer :global(.card) {
    flex: 1;
  }

  /* Decisiones */
  .decisions {
    margin: 0;
  }
  .decision {
    display: grid;
    gap: 0.5rem 3rem;
    grid-template-columns: 1fr;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
  }
  .decision:last-child {
    border-bottom: 1px solid var(--border);
  }
  .decision dt {
    color: var(--text);
    font-weight: 600;
    line-height: 1.5;
  }
  .decision dd {
    margin: 0;
  }
  @media (min-width: 52rem) {
    .decision {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    }
  }

  /* Hoja de ruta */
  .phases {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .phases > li {
    border-top: 1px solid var(--border);
  }
  .phases > li:last-child {
    border-bottom: 1px solid var(--border);
  }
  summary {
    display: grid;
    align-items: center;
    gap: 0.25rem 1.5rem;
    grid-template-columns: 5rem 1fr auto auto;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover .phase__title {
    color: var(--red-text);
  }
  .phase__id {
    color: var(--red-text);
    font-size: var(--fs-ui);
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .phase__title {
    color: var(--text);
    font-weight: 600;
    transition: color var(--t);
  }
  .phase__status {
    font-size: var(--fs-ui);
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .phase__status--done,
  .phase__status--doing {
    color: var(--text);
  }
  .phase__count {
    font-size: var(--fs-small);
    color: var(--text-muted);
    min-width: 4rem;
    text-align: right;
  }
  .phase__summary {
    margin: 0 0 1rem 6.5rem;
  }
  .items {
    list-style: none;
    margin: 0 0 1.5rem 6.5rem;
    padding: 0;
  }
  .item {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.2rem 0;
  }
  .item__mark {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    border: 1px solid var(--icon-neutral);
    transform: translateY(0.05rem);
  }
  .item--done .item__mark {
    background: var(--red);
    border-color: var(--red);
  }
  .item--doing .item__mark {
    background: linear-gradient(90deg, var(--red) 50%, transparent 50%);
    border-color: var(--red);
  }
  .item--done {
    color: var(--text);
  }

  @media (max-width: 40rem) {
    summary {
      grid-template-columns: 1fr auto;
    }
    .phase__id,
    .phase__title {
      grid-column: 1 / -1;
    }
    .phase__summary,
    .items {
      margin-left: 0;
    }
  }
</style>
