---
// Fuentes autoalojadas: Inter Variable para todo el texto y JetBrains Mono solo para datos técnicos
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import BastionNav, { type BastionTab } from '../components/BastionNav.astro';
import Footer from '../components/Footer.astro';
import { t, type Lang } from '../i18n/ui';
import { asset } from '../lib/url';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Ruta equivalente en el otro idioma. */
  altHref: string;
  noindex?: boolean;
  /** Muestra la barra de progreso de lectura (páginas largas). */
  progress?: boolean;
  /** «bastion» sustituye el menú del portafolio por el encabezado y las pestañas del área Bastión. */
  variant?: 'site' | 'bastion';
  tab?: BastionTab;
}

const { title, description, lang = 'es', altHref, noindex = false, progress = false, variant = 'site', tab = 'funcionamiento' } = Astro.props;
const fullTitle = title === 'Martín De Prada' ? title : `${title} · Martín De Prada`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = new URL(altHref, Astro.site);
const ogImage = new URL(asset('og.png'), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={alt} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#08090a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    {progress && <div class="progress" aria-hidden="true" />}
    <a class="skip-link" href="#contenido">{t(lang, 'nav.skip')}</a>
    {variant === 'bastion' ? <BastionNav lang={lang} altHref={altHref} current={tab} /> : <Nav lang={lang} altHref={altHref} />}
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
